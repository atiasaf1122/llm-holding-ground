# Every field of council.config.Settings is an environment variable with a
# COUNCIL_ prefix, read from a .env in the project root. Every one has a
# default, so an empty file runs -- but it does not run what was published: the
# one line uncommented below is the difference between an overnight job and a
# four-day one. Copy this to `.env` and change only what you mean to.
#
# Listed here are the settings that change a *result*, cost real time, or move
# where a run reads and writes. The full set, each with the reasoning for its
# default, is in src/council/config.py.

# -- the ones that decide whether a run finishes at all ------------------------

# How many contested points the debate arms are sampled down to. THE MOST
# IMPORTANT LINE IN THIS FILE, and the only one uncommented, because its default
# is "no limit": unset, the sweep runs every contested point the run produces --
# 984 of 1,002 on the published calendar, roughly 90 hours of continuous
# generation on two RTX 3090s.
#
# The published run set 60 here and answered 50: ten of the sixty had no placebo
# donor far enough back, and a point any arm cannot serve is withheld from all of
# them so the arms keep one identical point set. The sample is evenly spread and
# nested, so a larger budget contains a smaller one.
COUNCIL_MAX_DEBATE_POINTS=60

# Which card the process may use. An Ollama daemon keeps whatever devices it
# was started with, so this pins the client process, not the server. Set it if
# the machine is doing anything else.
# COUNCIL_CUDA_VISIBLE_DEVICES=1

# Concurrent requests to the daemon. Four gave x1.5 over sequential on the
# published hardware, not x4: inference is memory-bandwidth-bound.
# COUNCIL_CONCURRENCY=4

# -- the ones that change what is measured ------------------------------------

# The four base models. They must all be resident at once, because a debate
# round is four seats answering simultaneously. Ollama tags float -- the same
# name is republished -- which is the cause of the D16 vintage drift, and
# nothing here can pin it.
# COUNCIL_AGENT_MODELS=["qwen3.5:9b","granite4.1:8b","phi4:14b","gemma4:12b"]

# The universe and the calendar.
# COUNCIL_TICKERS=["AAPL","XOM"]
# COUNCIL_START=2022-01-01
# COUNCIL_END=2023-12-31

# What counts as changing one's mind, and what counts as a contested point.
# Both were fixed in the first commit, before any result existed: changing them
# changes the pre-registered primary statistic, and a number produced under a
# different bar is not comparable to a published one.
# COUNCIL_SHIFT_THRESHOLD=0.20
# COUNCIL_DISPERSION_THRESHOLD=0.25

# How far back a placebo donor must come from. The default is a full lookback
# window, so the donor's data cannot overlap the day being decided. Lowering it
# weakens the control rather than speeding anything up.
# COUNCIL_PLACEBO_MIN_GAP_SESSIONS=60

# When a conversation ends: agreement, then stillness, then the cap. The cap is
# a cap and not a length -- which condition ended a conversation is stored on
# every one of its rows.
# COUNCIL_AGREEMENT_SPREAD=0.20
# COUNCIL_STILLNESS_ROUNDS=2
# COUNCIL_MAX_DEBATE_ROUNDS=6

# Sampling determinism. Temperature 0 and a fixed seed still leave a ~2pp noise
# floor (D12); they do not make a run reproducible, only less variable.
# COUNCIL_SEED=20260101
# COUNCIL_TEMPERATURE=0.0

# What a decision is scored with. Costs are charged per side at the next
# session's open; the rebalance threshold is how far the target must move before
# a trade is worth booking.
# COUNCIL_COMMISSION_BPS=5.0
# COUNCIL_SLIPPAGE_BPS=5.0
# COUNCIL_REBALANCE_THRESHOLD=0.05

# How much history an agent sees. It is also the warm-up: the first
# lookback_days - 1 sessions of the price table carry no decision at all.
# COUNCIL_LOOKBACK_DAYS=60

# -- the ones that move a path -------------------------------------------------

# Where a run reads and writes. Point this at a fresh directory to run a variant
# without touching a published artefact -- which is how the disposition run (C31)
# was kept separate from the run it is compared against. Point it at a published
# run to inspect one:
#
#   COUNCIL_DATA_DIR=docs/results/run-4models-2y uv run council evaluate
#
# COUNCIL_DATA_DIR=data

# Where the prompt briefs are read from. The default is unset, not the path
# below: leaving it unset is what lets the provenance check know the prompts are
# the shipped ones. Set it only to run a variant, as the disposition run did.
# COUNCIL_PROMPTS_DIR=src/council/agents/prompts-disposition

# Where the daemon is.
# COUNCIL_OLLAMA_BASE_URL=http://localhost:11434
